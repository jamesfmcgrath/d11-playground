{#
/**
 * @file
 * Default theme implementation to display a single Drupal page.
 *
 * Variables:
 * - page.header: Items for the header region.
 * - page.primary_menu: Items for the primary menu region.
 * - page.content: The main content of the current page.
 * - page.sidebar_first: Items for the first sidebar.
 * - page.footer: Items for the footer region.
 *
 * @see template_preprocess_page()
 *
 * @ingroup themeable
 */
#}
{# templates/layout/page.html.twig #}
<div class="page-wrapper page-front d-flex flex-column h-100">
  <header class="site-header" role="banner">
    {% if page.header %}
      {{ page.header }}
    {% endif %}
    {% if page.primary_menu %}
      <nav class="navbar navbar-expand-md navbar-dark bg-dark" role="navigation" aria-label="Primary navigation">
        <div class="container-fluid">
          <a class="navbar-brand" href="{{ path('<front>') }}">{{ site_name }}</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarNav">
            {{ page.primary_menu }}
          </div>
        </div>
      </nav>
    {% endif %}
  </header>

  <main class="main-content flex-shrink-0" role="main">
    <div class="container-fluid px-0">
      {{ page.content }}
    </div>
  </main>

  <footer class="site-footer mt-auto py-3 bg-light" role="contentinfo">
    {% if page.footer %}
      <div class="container">
        <div class="region region-footer">
          {{ page.footer }}
        </div>
      </div>
    {% endif %}
  </footer>
</div>

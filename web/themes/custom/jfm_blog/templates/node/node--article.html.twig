{#
/**
 * @file
 * Template for full article node display.
 *
 * This template is used when viewing an article node in full view mode.
 * It provides semantic HTML5 structure for displaying a complete blog post
 * with featured image, title, metadata, body content, and tags.
 *
 * TODO: Will be refactored to use article-full component in Phase 4.
 *
 * Available variables:
 * - node: The article node entity
 * - content: Array of field render arrays
 * - label: The title of the article
 */
#}
<article{{ attributes.addClass('article', 'article--full') }}>
  {# Featured image #}
  {% if content.field_image %}
    <div class="article__image">
      {{ content.field_image }}
    </div>
  {% endif %}

  {# Article header with title and metadata #}
  <header class="article__header">

    {# Metadata: date and author #}
    <div class="article__metadata">
      {% if node.created.value %}
        <time datetime="{{ node.created.value|date('c') }}" class="article__date">
          {{ node.created.value|date('F j, Y') }}
        </time>
      {% endif %}
      {% if content.field_author %}
        <span class="article__author">{{ content.field_author }}</span>
      {% endif %}
    </div>
  </header>

  {# Article body content #}
  <div class="article__body">
    {{ content.body }}
  </div>

  {# Tags #}
  {% if content.field_tags %}
    <footer class="article__footer">
      <div class="article__tags">
        {{ content.field_tags }}
      </div>
    </footer>
  {% endif %}
</article>

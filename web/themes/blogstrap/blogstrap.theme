<?php

/**
 * @file
 * Theme functions for Blogstrap theme.
 */

use Drupal\Core\Template\Attribute;

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function blogstrap_preprocess_page(array &$variables) {
  // Add variables or modify the template variables here.
  // Example: Add custom classes to the page wrapper.
  if (!isset($variables['attributes']['class'])) {
    $variables['attributes']['class'] = [];
  }
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function blogstrap_preprocess_node(array &$variables) {
  $node = $variables['node'];
  if ($node->getType() == 'article') {
    // Add specific preprocessing logic for articles.
    if (!isset($variables['attributes']['class'])) {
      $variables['attributes']['class'] = [];
    }
    $variables['attributes']['class'][] = 'node--article';
  }
}

/**
 * Implements hook_preprocess_HOOK() for block templates.
 */
function blogstrap_preprocess_block(array &$variables) {
  // Add variables or modify the template variables here.
  // Add default classes if not already set.
  if (!isset($variables['attributes']['class'])) {
    $variables['attributes']['class'] = [];
  }
  $variables['attributes']['class'][] = 'block';
  $variables['attributes']['class'][] = 'block--' . str_replace('_', '-', $variables['plugin_id']);
}

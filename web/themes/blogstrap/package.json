  "license": "ISC",
  "description": "A simple blog theme using Bootstrap 5 for Drupal 11.",
  "dependencies": {
    "@popperjs/core": "^2.11.6",
    "bootstrap": "^5.3.0"
  },
  "devDependencies": {
    "sass": "^1.97.3"
  }
}

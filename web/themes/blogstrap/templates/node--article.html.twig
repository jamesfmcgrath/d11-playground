{#
/**
 * @file
 * Template for article node type.
 *
 * Available variables:
 * - node: The node entity
 * - label: Node title
 * - content: Node content (all fields)
 * - attributes: HTML attributes for the containing element
 * - title_attributes: HTML attributes for the title element
 * - display_submitted: Whether submission information should be displayed
 * - submitted: Submission information created from author and date
 */
#}
<article{{ attributes.addClass('node', 'node--article') }}>
  {% if title_prefix %}
    {{ title_prefix }}
  {% endif %}

  {% if not page %}
    <h2{{ title_attributes.addClass('node__title') }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% else %}
    <h1{{ title_attributes.addClass('node__title') }}>{{ label }}</h1>
  {% endif %}

  {% if title_suffix %}
    {{ title_suffix }}
  {% endif %}

  {% if display_submitted %}
    <div class="node__meta text-muted small mb-3">
      {{ submitted }}
    </div>
  {% endif %}

  <div class="node__content">
    {{ content|without('links', 'comment') }}
  </div>

  {% if content.links %}
    <div class="node__links mt-4">
      {{ content.links }}
    </div>
  {% endif %}

  {{ content.comment }}
</article>

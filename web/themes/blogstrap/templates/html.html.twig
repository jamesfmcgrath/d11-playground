{#
/**
 * @file
 * HTML structure template for Blogstrap theme.
 *
 * Available variables:
 * - html_attributes: HTML attributes for the HTML element
 * - head_title: A modified version of the page title
 * - placeholder_token: The token for generating head, css, js and js-bottom placeholders
 * - attributes: HTML attributes for the body element
 * - page: The rendered page content
 */
#}
<!DOCTYPE html>
<html{{ html_attributes }}>
  <head>
    <head-placeholder token="{{ placeholder_token|raw }}">
    <title>{{ head_title|safe_join(' | ') }}</title>
    <css-placeholder token="{{ placeholder_token|raw }}">
    <js-placeholder token="{{ placeholder_token|raw }}">
  </head>
  <body{{ attributes }}>
    <a href="#main-content" class="visually-hidden focusable">
      {{ 'Skip to main content'|t }}
    </a>
    {{ page }}
    <js-bottom-placeholder token="{{ placeholder_token|raw }}">
  </body>
</html>

{#
/**
 * @file
 * Default page template for Blogstrap theme.
 *
 * Available variables:
 * - page: The page content
 * - page.header: Header region
 * - page.primary_menu: Primary menu region
 * - page.content: Content region
 * - page.sidebar_left: Sidebar left region
 * - page.sidebar_right: Sidebar right region
 * - page.footer: Footer region
 */
#}
{% include '@blogstrap/layout/layout.twig' with {
  'site_name': site_name,
  'site_slogan': site_slogan|default(''),
  'header_content': page.header,
  'menu_content': page.primary_menu,
  'menu_label': 'Primary menu'|t,
  'highlighted': page.highlighted,
  'help': page.help,
  'sidebar_left': page.sidebar_left,
  'sidebar_right': page.sidebar_right,
  'content': page.content,
  'footer_content': page.footer,
  'copyright_year': 'now'|date('Y')
} %}
